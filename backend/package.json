{
  "name": "hvac-digital-twin-backend",
  "version": "2.0.0",
  "type": "module",
  "description": "Backend API for Smart Building HVAC Digital Twin",
  "main": "src/index.js",
  "scripts": {
    "prestart": "node --import ./src/load-env.js src/check-node-version.js",
    "start": "node --import ./src/load-env.js --import tsx src/index.js",
    "predev": "node --import ./src/load-env.js src/check-node-version.js",
    "dev": "node --import ./src/load-env.js --import tsx --watch src/index.js",
    "pretest": "node --import ./src/load-env.js src/check-node-version.js",
    "test": "node --import tsx --test tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "keywords": [
    "hvac",
    "digital-twin",
    "simulation",
    "foundry-local"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "foundry-local-sdk": "^0.9.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
